{
  "name": "m12-cms/package-skeleton",
  "description": "Skeleton package for {{package_studly}}",
  "type": "library",
  "license": "Apache-2.0",
  "autoload": {
    "psr-4": {
      "{{namespace}}\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "{{namespace}}\\Tests\\": "tests/",
      "{{namespace}}\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "{{namespace}}\\Providers\\PackageServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5",
    "laravel/pint": "^1.26",
    "phpstan/phpstan": "^2.0",
    "nunomaduro/larastan": "^3.0@beta"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "pint": "pint",
    "check": [
      "composer pint",
      "composer analyse",
      "composer test"
    ]
  }
}
